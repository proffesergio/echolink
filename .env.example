# Neon CLI writes these to .env.local. Do not paste credentials into chat.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
STORAGE_BUCKET=echolink-archives
# At least 32 random characters. Store the same key in n8n HTTP Header Auth.
WORKER_API_KEY=
DRY_RUN=true
PAGE_CONCURRENCY=1
FEED_CONCURRENCY=4
MAX_ITEMS_PER_FEED=5
ARTICLE_TIMEOUT_MS=15000
AI_TIMEOUT_MS=300000
PORT=8787
HOST=127.0.0.1
# Direct local dashboard login. Quote values containing #, spaces or punctuation.
# A nonempty DASHBOARD_PASSWORD takes precedence over DASHBOARD_PASSWORD_HASH.
DASHBOARD_PASSWORD=
# Settings can instead save a password hash, clearing DASHBOARD_PASSWORD.
DASHBOARD_PASSWORD_HASH=
# Optional exact HTTPS dashboard origin when using the Vercel proxy deployment.
DASHBOARD_PUBLIC_ORIGIN=
# Optional API key from n8n Settings > n8n API, for immediate dashboard Start/Stop.
N8N_API_KEY=
N8N_BASE_URL=http://localhost:5678
# One connected workflow ticks each minute; worker gates the individual jobs.
SYNC_INTERVAL_MINUTES=15
INGEST_INTERVAL_MINUTES=10
APPROVALS_INTERVAL_MINUTES=1
PROCESS_INTERVAL_MINUTES=2
COMMENTS_INTERVAL_MINUTES=1
MIRROR_INTERVAL_MINUTES=2
ANALYTICS_INTERVAL_MINUTES=360
AIRTABLE_BASE_ID=
AIRTABLE_WORKSPACE_ID=
AIRTABLE_LOG_TIMESTAMP_WRITABLE=false
AIRTABLE_TOKEN=
AIRTABLE_PAGES_TABLE=[] Page Configurations
AIRTABLE_FEEDS_TABLE=[] Ingestion Feeds
AIRTABLE_LOG_TABLE=[] Content Log & Deduplication
# Alias -> token JSON maps, referenced by Airtable. Keep tokens out of Airtable.
AI_TOKENS_JSON={}
FB_TOKENS_JSON={}
# Owner opted out: no automatic source/website link comments. Explicitly reviewed
# custom captions are preserved; unexpected AI URLs require review.
FB_AUTOMATIC_LINKS_ENABLED=false
META_GRAPH_VERSION=
ALLOWED_AI_HOSTS=localhost,127.0.0.1,host.docker.internal,ollama,localai,lmstudio
# Add every RSS source, redirect destination and article host before enabling ingestion.
ALLOWED_SOURCE_HOSTS=feeds.bbci.co.uk,www.bbc.com,www.bbc.co.uk
SEMANTIC_ENABLED=false
EMBEDDING_URL=http://localhost:11434/v1/embeddings
EMBEDDING_MODEL=embeddinggemma:latest
EMBEDDING_TOKEN=
# Calibration starting point, not a universal safe threshold. Keep disabled until
# real Page stories and important updates have been reviewed; see docs/SEMANTIC_DEDUPLICATION.md.
SEMANTIC_THRESHOLD=0.95
SEMANTIC_TTL_DAYS=7
# Optional additional post log. Share your spreadsheet with the service account.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=EchoLink Posts
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional NobleSeek website publisher (separate from EchoLink's DATABASE_URL).
# PostgreSQL URI from the production Fabrything Django database; keep it private.
NOBLESEEK_DATABASE_URL=
# Keep disabled during setup. Only listed Facebook Page IDs use this destination.
NOBLESEEK_ENABLED=false
NOBLESEEK_REQUIRE_BEFORE_FACEBOOK=false
NOBLESEEK_FACEBOOK_PAGE_IDS=236380006216214
NOBLESEEK_SITE_URL=https://www.fabrything.com
NOBLESEEK_API_BASE_URL=https://fabrythingapi.vercel.app/api/store/nobleseek
NOBLESEEK_DATABASE_SCHEMA=public
# Optional active nobleseek_newscategory ID; blank publishes without a category.
NOBLESEEK_CATEGORY_ID=
# Optional Slack incoming webhook; leave empty until notifications are wanted.
APPROVAL_NOTIFICATION_URL=
# For verify:services only. Choose an enabled chat model from the gateway catalog.
VERIFY_AI_MODEL=
NEON_FUNCTION_ECHOLINKAPI_BASE_URL=
# Optional Neon cloud companion. Requires supported region and gateway access.
ECHOLINK_ENABLE_CLOUD=false
