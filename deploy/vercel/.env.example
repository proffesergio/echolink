# Server-only Vercel environment variables. No VITE_/NEXT_PUBLIC_ credentials.
WORKER_ORIGIN=https://your-worker.example.com
DASHBOARD_PUBLIC_ORIGIN=https://your-dashboard.vercel.app
# Required for the local restricted bridge (same random value as local .env.local).
WORKER_BRIDGE_TOKEN=
# Optional when Cloudflare Access protects the worker hostname.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
