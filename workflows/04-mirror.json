{
  "name": "EchoLink — mirror",
  "active": false,
  "nodes": [
    {
      "id": "9a1e122e-aed5-4eea-ab9a-541ce74011de",
      "name": "Setup notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        100,
        40
      ],
      "parameters": {
        "width": 720,
        "height": 150,
        "content": "## EchoLink: mirror\nRuns every 2 minutes. Select an HTTP Header Auth credential on Run job: name Authorization; value Bearer <WORKER_API_KEY>.\nWindows npm n8n and worker use 127.0.0.1:8787. For Docker n8n rebuild with ECHOLINK_WORKER_URL set to a reachable worker address. Import inactive, test manually, then activate."
      }
    },
    {
      "id": "2043561a-1a86-419d-b619-eaddc93fb590",
      "name": "Manual test",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        120,
        260
      ],
      "parameters": {}
    },
    {
      "id": "1951ebfe-e415-4ddd-95b9-e3992b28141c",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        120,
        440
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      }
    },
    {
      "id": "95d9d26c-267f-4050-9ea7-ac48b736b90e",
      "name": "Run job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        320
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8787/jobs/mirror",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 900000
        }
      },
      "retryOnFail": false
    }
  ],
  "connections": {
    "Manual test": {
      "main": [
        [
          {
            "node": "Run job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Schedule": {
      "main": [
        [
          {
            "node": "Run job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Dhaka",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all"
  },
  "pinData": {}
}
