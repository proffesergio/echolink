# Isolated development database, never the live newsroom database.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Use websocket on networks where direct PostgreSQL TCP is unreliable.
PLATFORM_DATABASE_TRANSPORT=tcp
PLATFORM_BRANCH=echolink-platform-local
PLATFORM_ENV=development
PLATFORM_PORT=8790
PLATFORM_ORIGIN=http://localhost:8790
PLATFORM_OWNER_EMAIL=
BETTER_AUTH_SECRET=
PLATFORM_ENCRYPTION_KEY=
PLATFORM_WORKER_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Keep these disabled for local acceptance; no test posts or ad spend.
PLATFORM_PUBLISHING_ENABLED=false
PLATFORM_AD_SPENDING_ENABLED=false
PLATFORM_BILLING_MODE=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Local endpoints are operator-owned. Tenants cannot choose LAN destinations.
PLATFORM_OLLAMA_URL=http://127.0.0.1:11434
PLATFORM_LM_STUDIO_URL=http://127.0.0.1:1234
PLATFORM_LOCALAI_URL=http://127.0.0.1:8080
PLATFORM_COMFYUI_URL=http://127.0.0.1:8188
PLATFORM_COMFYUI_WORKFLOW_PATH=
PLATFORM_A1111_URL=http://127.0.0.1:7860

# Optional executable override. setup-creative-tools.ps1 installs the default local CPU cutout.
PLATFORM_REMBG_PYTHON=
# Optional: u2netp (small), u2net, isnet-general-use. Only installed models run.
# Empty uses cached IS-Net when available, otherwise the small U2-Net model.
PLATFORM_REMBG_MODEL=
PLATFORM_OLLAMA_EXECUTABLE=
PLATFORM_INFERENCE_IDLE_SECONDS=30
PLATFORM_INFERENCE_PROFILE=windows_safe
PLATFORM_INFERENCE_REMOTE=false
PLATFORM_INFERENCE_MAX_CONTEXT=4096
PLATFORM_INFERENCE_RESERVE_MB=1536
# Per local model call, 30–3600 seconds. Independent of publication scheduling.
PLATFORM_INFERENCE_TIMEOUT_SECONDS=1200
# Cross-platform PostgreSQL executables, e.g. /usr/lib/postgresql/18/bin.
PG_BIN_DIR=
PLATFORM_OLLAMA_LOCAL_ONLY=true
# Operator-only optional override; the safe profile otherwise limits model files to 4 GB.
# PLATFORM_INFERENCE_MAX_MODEL_GB=4
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_MAX_QUEUE=4
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_KEEP_ALIVE=30s
OLLAMA_NO_CLOUD=1
OLLAMA_VULKAN=0

# PostgreSQL runtime TLS/pool settings. Keep admin URLs separate.
DATABASE_POOL_MAX=2
PLATFORM_WORKER_ENABLED=true
DATABASE_CA_CERT_BASE64=
# Optional named operator profiles (never use VITE_ prefixes)
NEON_DATABASE_URL=
AIVEN_DATABASE_URL=
AIVEN_CA_CERT_BASE64=
LOCAL_POSTGRES_DATABASE_URL=
# Reader URL on Vercel; separate writer URL only on the worker
WORKER_REGISTRY_PROVIDER=
WORKER_REGISTRY_CA_CERT_BASE64=
WORKER_REGISTRY_WRITE_URL=

# Optional cloud database / queue. Blank values retain the current local setup.
SUPABASE_DATABASE_URL=
SUPABASE_DATABASE_URL_UNPOOLED=
SUPABASE_CA_CERT_BASE64=
REDIS_URL=
PLATFORM_QUEUE_BACKEND=postgres
PLATFORM_QUEUE_PREFIX=echolink-v2
