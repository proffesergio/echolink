# Isolated development database, never the live newsroom database.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
PLATFORM_BRANCH=echolink-platform-local
PLATFORM_ENV=development
PLATFORM_PORT=8790
PLATFORM_ORIGIN=http://localhost:8790
PLATFORM_OWNER_EMAIL=
BETTER_AUTH_SECRET=
PLATFORM_ENCRYPTION_KEY=
PLATFORM_WORKER_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Keep these disabled for local acceptance; no test posts or ad spend.
PLATFORM_PUBLISHING_ENABLED=false
PLATFORM_AD_SPENDING_ENABLED=false
PLATFORM_BILLING_MODE=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Local endpoints are operator-owned. Tenants cannot choose LAN destinations.
PLATFORM_OLLAMA_URL=http://127.0.0.1:11434
PLATFORM_LM_STUDIO_URL=http://127.0.0.1:1234
PLATFORM_LOCALAI_URL=http://127.0.0.1:8080
PLATFORM_COMFYUI_URL=http://127.0.0.1:8188
PLATFORM_COMFYUI_WORKFLOW_PATH=
PLATFORM_A1111_URL=http://127.0.0.1:7860
